---
import Brand from './Brand.astro';
import Icon from './Icon.astro';
import { nav, site, pagePath } from '../lib/site';
const path = pagePath(Astro.url);
const current = (href: string) => (href === path ? 'page' : undefined);
---
<header class="site-header">
  <div class="wrap">
    <Brand />

    <!-- Wide screens: one drop-down list per group. The shared "name" keeps only one list open. -->
    <nav class="nav-desktop" aria-label="Main menu">
      {nav.groups.map((group) => (
        <details name="main-menu">
          <summary>{group.label}<Icon name="chevron-down" /></summary>
          <ul class="panel">
            {group.items.map((item) => (
              <li>
                <a href={item.href} aria-current={current(item.href)}>
                  <Icon name={item.icon} />
                  <span><strong>{item.label}</strong><small>{item.description}</small></span>
                </a>
              </li>
            ))}
          </ul>
        </details>
      ))}
      <a class="nav-tool" href="/search/" aria-label="Search"><Icon name="explore" /></a>
      <a class="btn btn-primary nav-launch" href={site.platformUrl} target="_blank" rel="noopener">Launch AIO Platform<span class="sr-only"> (opens in a new tab)</span></a>
    </nav>

    <!-- Narrow screens: one "Menu" button that shows all groups as plain lists. -->
    <details class="nav-mobile">
      <summary>Menu</summary>
      <nav class="mobile-panel" aria-label="Main menu">
        {[...nav.groups, nav.site].map((group) => (
          <>
            <h2><Icon name={group.icon} />{group.label}</h2>
            <ul>{group.items.map((item) => <li><a href={item.href} aria-current={current(item.href)}>{item.label}</a></li>)}</ul>
          </>
        ))}
        <a class="btn btn-primary" href={site.platformUrl} target="_blank" rel="noopener">Launch AIO Platform<span class="sr-only"> (opens in a new tab)</span></a>
      </nav>
    </details>
  </div>
</header>
